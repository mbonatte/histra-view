+def _resolve_model(model_or_hrx: Any):
+    if hasattr(model_or_hrx, "collections") and hasattr(model_or_hrx, "gdl"):
+        return model_or_hrx
+    from histra.io.hr_loader import load_model
+
+    return load_model(model_or_hrx)
